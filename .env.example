APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=sqlite:///./data/noteflow.db
APP_AUTO_CREATE_DB=true

ASR_MODEL_MODE=qwen-0.6b
MEGA_ASR_DEVICE=cpu
ASR_DTYPE=float32
ASR_MAX_FILE_MB=100
ASR_MAX_DURATION_SECONDS=3600
ASR_ALLOW_TEXT_FALLBACK=true

OCR_ENGINE=paddleocr
OCR_LANGUAGE=en
OCR_DEVICE=cpu
OCR_MAX_FILE_MB=50
OCR_MAX_PDF_PAGES=50
OCR_GENERAL_CONFIDENCE_THRESHOLD=0.80
OCR_IMPORTANT_CONFIDENCE_THRESHOLD=0.90
OCR_CRITICAL_CONFIDENCE_THRESHOLD=0.95
OCR_ALLOW_TEXT_FALLBACK=true

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120

UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
EXPORT_DIR=./data/exports

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=/api
