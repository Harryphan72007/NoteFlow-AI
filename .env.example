APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
AUTH_SECRET=replace-with-a-random-local-secret
AUTH_DEFAULT_USERNAME=local.user
AUTH_DEFAULT_PASSWORD=noteflow-local

DATABASE_URL=sqlite:///./data/noteflow.db
APP_AUTO_CREATE_DB=true

ASR_MODEL_MODE=Qwen3-ASR-0.6B
MEGA_ASR_DEVICE=cpu
MEGA_ASR_ROOT=D:/Mega-ASR/Mega-ASR
MEGA_ASR_PYTHON=C:/Users/Dell/anaconda3/envs/mega-asr/python.exe
MEGA_ASR_CKPT_DIR=D:/Mega-ASR/Mega-ASR/ckpt/Mega-ASR
QWEN_ASR_SMALL_MODEL_DIR=D:/Mega-ASR/Mega-ASR/ckpt/Mega-ASR/Qwen3-ASR-0.6B
MEGA_ASR_NUMBA_CACHE_DIR=./data/models/numba_cache
MEGA_ASR_TIMEOUT_SECONDS=3600
ASR_SMALL_TIMEOUT_SECONDS=300
ASR_MAX_NEW_TOKENS=256
ASR_DTYPE=float32
ASR_MAX_FILE_MB=100
ASR_MAX_DURATION_SECONDS=3600
ASR_ALLOW_TEXT_FALLBACK=false

OCR_ENGINE=paddleocr
OCR_LANGUAGE=en
OCR_DEVICE=cpu
OCR_DETECTION_MODEL_DIR=./data/models/paddleocr/PP-OCRv6_medium_det
OCR_RECOGNITION_MODEL_DIR=./data/models/paddleocr/PP-OCRv6_medium_rec
OCR_MAX_FILE_MB=50
OCR_MAX_PDF_PAGES=50
OCR_GENERAL_CONFIDENCE_THRESHOLD=0.80
OCR_IMPORTANT_CONFIDENCE_THRESHOLD=0.90
OCR_CRITICAL_CONFIDENCE_THRESHOLD=0.95
OCR_ALLOW_TEXT_FALLBACK=false

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=30m

UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
EXPORT_DIR=./data/exports

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=/api
